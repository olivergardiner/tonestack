# Build trees and packaged output
/build/
/build-*/
/cmake-build-*/
/out/
/dist/
/debug/
/release/
[Dd]ebug/
[Rr]elease/

# CMake and qmake files generated by in-source builds
/CMakeCache.txt
/CMakeFiles/
/Testing/
/cmake_install.cmake
/install_manifest.txt
/CTestTestfile.cmake
/CMakeUserPresets.json
/.qmake.stash
/.qmake.cache
/Makefile
/Makefile.Debug
/Makefile.Release
/.qtc_clangd/

# Generated Qt code (edit the .ui/.qrc/source files instead)
/ui_*.h
/moc_*.cpp
/moc_*.h
/qrc_*.cpp
/moc_predefs.h

# Compiled binaries and linker/debug output
*.exe
*.dll
*.obj
*.o
*.pdb
*.ilk
*.idb
*.ipch
*.pch
*.exp
*.lib
*.a
# Required bundled ngspice runtime and import library are project dependencies.
!/ngspice/ngspice.dll
!/ngspice/ngspice.lib

# Local IDE state; retain shared .vscode tasks/settings/launch configuration
.vs/
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
*.vcxproj.user
*.pro.user
*.pro.user.*

# LaTeX intermediates from circuit diagram authoring.
# Keep .tex, PDF, PNG, SVG and Visio assets available to version control.
/circuits/**/*.aux
/circuits/**/*.fdb_latexmk
/circuits/**/*.fls
/circuits/**/*.log
/circuits/**/*.synctex.gz
/circuits/**/*.out
/circuits/**/*.toc
/circuits/**/*.xdv

# Office/Visio locks, editor backups and accidental Windows shell output
~$*
*.~vsdx
.~lock.*#
*~
*.swp
*.swo
/nul
